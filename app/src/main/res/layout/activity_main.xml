<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#090A0F">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
        <TextView android:id="@+id/brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUCINE" android:textColor="#FFB300" android:textSize="21sp" android:textStyle="bold"/>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:text="VIP" android:textColor="#111111" android:background="@drawable/bg_button" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:textStyle="bold" android:textSize="11sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingBottom="10dp">
        <EditText android:id="@+id/search" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:hint="Buscar filmes, canais..." android:textColor="#F4F5F8" android:textColorHint="#8B92A7" android:singleLine="true" android:paddingLeft="14dp" android:paddingRight="14dp" android:background="@drawable/bg_search" android:inputType="text"/>
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="48dp" android:scrollbars="none" android:paddingLeft="12dp" android:paddingRight="12dp">
        <LinearLayout android:id="@+id/chips" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical"/>
    </HorizontalScrollView>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="Carregando catálogo..." android:textColor="#8B92A7" android:textSize="12sp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="8dp" android:clipToPadding="false"/>
    <LinearLayout android:id="@+id/bottom" android:layout_width="match_parent" android:layout_height="68dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_bottom" android:padding="5dp">
        <Button android:id="@+id/navHome" style="@style/NavButton" android:text="Início"/>
        <Button android:id="@+id/navMovies" style="@style/NavButton" android:text="Filmes"/>
        <Button android:id="@+id/navChannels" style="@style/NavButton" android:text="Canais"/>
        <Button android:id="@+id/navFav" style="@style/NavButton" android:text="Minha lista"/>
        <Button android:id="@+id/navSettings" style="@style/NavButton" android:text="Config."/>
    </LinearLayout>
</LinearLayout>
